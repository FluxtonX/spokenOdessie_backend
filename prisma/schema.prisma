datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  password              String?           // Hashed (null for Google-only accounts)
  googleId              String?           @unique
  displayName           String?
  photoURL              String?           // Public URL
  photoKey              String?           // S3 Key for profile picture
  coverURL              String?           // Public URL
  coverKey              String?           // S3 Key for cover photo
  bio                   String            @default("")
  profession            String            @default("")
  location              String            @default("Earth")
  birthDate             String            @default("")
  lifeMotto             String            @default("")
  expertise             String[]          @default([])
  defaultEntryPrivacy   String            @default("Private - Only by you")
  profileVisibility     String            @default("Follower only")
  onboardingCompleted   Boolean           @default(false)
  profileCompleted      Boolean           @default(false)
  role                  Role              @default(USER)
  isActive              Boolean           @default(true)
  lastLogin             DateTime          @default(now())
  lastActive            DateTime          @default(now())
  
  // Forgot Password fields
  passwordResetToken   String?           @unique
  passwordResetExpires DateTime?
  
  // Phone number for SMS invitations
  phoneNumber           String?           @unique
  countryCode           String?           @default("+1")
  phoneVerified         Boolean           @default(false)
  
  // Custom metadata (personality Q&As, goals, projects, values, etc.)
  goals                 String            @default("")
  projects              String            @default("")
  achievements          String            @default("")
  interests             String            @default("")
  lessons               String            @default("")
  values                String            @default("")
  causes                String            @default("")
  personalityQs         Json              @default("[{\"q\":\"What is your happiest memory from childhood?\",\"a\":\"\"},{\"q\":\"How would you like to be remembered?\",\"a\":\"\"}]")
  recentInteractions    Json              @default("[]")

  // Relations
  memories              Memory[]
  albums                Album[]
  comments              Comment[]
  postReactions         PostReaction[]
  commentReactions      CommentReaction[]
  
  // Self-referencing Follows
  followers             Follow[]          @relation("following")
  following             Follow[]          @relation("follower")

  // Bidirectional Family Connections (represented via a junction table)
  familyConnectsAsFirst FamilyConnection[] @relation("user1")
  familyConnectsAsSec   FamilyConnection[] @relation("user2")

  // Family Invitations
  sentInvitations       FamilyInvitation[] @relation("InvitationSender")
  receivedInvitations   FamilyInvitation[] @relation("InvitationReceiver")

  // Family Circle Memberships
  familyMemberships     FamilyMember[]

  // Notifications
  notifications         Notification[]
  deviceTokens          DeviceToken[]

  // Legacy Access Settings
  legacySettings        LegacySettings?

  // MFA & Security Configuration
  mfaEnabled            Boolean           @default(false)
  mfaTypes              String[]          @default([])
  totpSecret            MfaTotpSecret?
  passkeys              Passkey[]
  recoveryCodes         MfaRecoveryCode[]
  auditLogs             SecurityAuditLog[]
  sessions              UserSession[]
  passwordChangedAt     DateTime?
  loginNotifications    Boolean           @default(true)
  notificationPreferences Json?           @default("{\"followerActivity\":true,\"familyActivity\":true,\"memoryInteractions\":true,\"securityAlerts\":true,\"loginNotifications\":true}")
  // Store Relations
  storeCarts            StoreCart[]
  storeOrders           StoreOrder[]
  storeReviews          StoreReview[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([email])
  @@index([phoneNumber])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique // Session JTI or token hash
  deviceName   String   @default("Web Device")
  deviceType   String   @default("desktop")
  ipAddress    String?
  userAgent    String?
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum FamilyRole {
  ADMIN
  MEMBER
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FamilyConnection {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String

  user1     User     @relation("user1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("user2", fields: [user2Id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model FamilyCircle {
  id          String   @id @default(uuid())
  name        String   @default("My Family")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     FamilyMember[]
  invitations FamilyInvitation[]
}

model FamilyMember {
  id              String       @id @default(uuid())
  familyCircleId  String
  userId          String
  role            FamilyRole   @default(MEMBER)
  relationship    String       @default("Family Member")
  invitedBy       String?
  approvedBy      String?

  familyCircle    FamilyCircle @relation(fields: [familyCircleId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt        DateTime     @default(now())
  approvedAt      DateTime?

  @@unique([familyCircleId, userId])
  @@index([familyCircleId])
  @@index([userId])
  @@index([role])
}

model FamilyInvitation {
  id              String   @id @default(uuid())
  familyCircleId  String
  senderId        String
  receiverId      String?
  email           String?
  phoneNumber     String?
  countryCode     String?   @default("+1")
  invitationToken String   @unique
  relationship    String   @default("Family Member")
  status          String   @default("PENDING") // PENDING, ACCEPTED, APPROVED, DECLINED, EXPIRED
  method          String   @default("EMAIL") // EMAIL, SMS, LINK, QR

  sender          User     @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User?    @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  familyCircle    FamilyCircle @relation(fields: [familyCircleId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime?
  acceptedAt      DateTime?
  approvedAt      DateTime?

  @@index([senderId])
  @@index([receiverId])
  @@index([email])
  @@index([phoneNumber])
  @@index([status])
  @@index([invitationToken])
  @@index([familyCircleId])
}

model Album {
  id               String   @id @default(uuid())
  title            String
  subtitle         String   @default("")
  coverImageKey    String?
  privacy          String   @default("Private")
  entries          Int      @default(0)
  
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  memories         Memory[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
  @@index([privacy])
}

model Memory {
  id                String         @id @default(uuid())
  title             String
  description       String         @default("")
  tags              String[]       @default([])
  taggedUserIds     String[]       @default([])
  mood              String         @default("")
  privacy           String         @default("Private")
  type              String         @default("Text")
  status            String         @default("draft")
  occurredAt        DateTime       @default(now())
  color             String         @default("")
  backgroundId      String         @default("none")
  fontId            String         @default("default")

  // Legacy single file keys (for backwards compatibility)
  mediaKey          String?
  thumbnailKey      String?
  mediaOriginalName String         @default("")
  mediaMimeType     String         @default("")

  // Multi-media list support (stored as structured JSON)
  mediaList         Json           @default("[]")

  // Counters
  likes             Int            @default(0)
  commentsCount     Int            @default(0)
  shares            Int            @default(0)

  ownerId           String
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  albumId           String?
  album             Album?         @relation(fields: [albumId], references: [id], onDelete: SetNull)

  comments          Comment[]
  reactions         PostReaction[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([ownerId])
  @@index([albumId])
  @@index([status])
  @@index([privacy])
}

model PostReaction {
  id        String   @id @default(uuid())
  memoryId  String
  userId    String
  type      String   // "heart", "like", "wow", "haha", "angry"

  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([memoryId, userId])
  @@index([memoryId])
  @@index([userId])
}

model Comment {
  id              String            @id @default(uuid())
  text            String
  reactionsCount  Json              @default("{\"like\":0,\"love\":0,\"haha\":0,\"wow\":0,\"sad\":0}")
  
  memoryId        String
  memory          Memory            @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  parentCommentId String?
  parentComment   Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]         @relation("CommentReplies")

  reactions       CommentReaction[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([memoryId])
  @@index([ownerId])
  @@index([parentCommentId])
}

model CommentReaction {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  type      String   // "like", "love", "haha", "wow", "sad"

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "FAMILY_INVITE_ACCEPTED", "FAMILY_INVITE_APPROVED", "FAMILY_INVITE_DECLINED", "MEMORY_LIKE", "MEMORY_COMMENT", etc.
  title       String
  message     String
  metadata    Json?    // Additional data (e.g., invitationId, familyCircleId, etc.)
  isRead      Boolean  @default(false)
  actionUrl   String?  // URL to navigate to when clicked

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  deviceType String   @default("web")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model LegacySettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  administratorId     String?
  administratorName   String   @default("Sarah Murphy")

  releaseCondition    String   @default("After verified passing")
  familyCircleAccess  String   @default("Full archive")
  publicProfile       String   @default("Remain public")

  isReleased          Boolean  @default(false)
  releasedAt          DateTime?
  releasedBy          String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

model MfaTotpSecret {
  id          String   @id @default(uuid())
  userId      String   @unique
  secret      String
  verified    Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Passkey {
  id           String   @id @default(uuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[] @default([])
  deviceName   String   @default("Passkey")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
  @@index([credentialId])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([codeHash])
}

model SecurityAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ==========================================
// ODYSSEY STORE E-COMMERCE DOMAIN MODELS
// ==========================================

enum StoreProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StoreOrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  PAYMENT_FAILED
  CANCELLED
  REFUNDED
  RETURN_REQUESTED
  RETURNED
}

enum StorePaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum StoreCouponType {
  PERCENTAGE
  FIXED
}

enum StoreShipmentStatus {
  PREPARING
  PACKED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED
}

model StoreCategory {
  id          String         @id @default(uuid())
  name        String         @unique
  slug        String         @unique
  description String?
  image       String?
  isActive    Boolean        @default(true)
  order       Int            @default(0)
  products    StoreProduct[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([slug])
  @@index([isActive])
}

model StoreProduct {
  id                String                @id @default(uuid())
  slug              String                @unique
  name              String
  tagline           String?               @default("")
  badge             String?               @default("")
  rating            Float                 @default(5.0)
  reviewsCount      Int                   @default(0)
  basePrice         Float
  originalPrice     Float?
  description       String
  features          String[]              @default([])
  specs             Json?                 @default("{}")
  images            Json?                 @default("{}")
  hardwareHotspots  Json?                 @default("[]")
  status            StoreProductStatus    @default(ACTIVE)
  featured          Boolean               @default(false)
  categoryId        String?
  category          StoreCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants          StoreProductVariant[]
  options           StoreProductOption[]
  inventory         StoreInventory[]
  cartItems         StoreCartItem[]
  orderItems        StoreOrderItem[]
  reviews           StoreReview[]

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([featured])
}

model StoreProductVariant {
  id              String           @id @default(uuid())
  productId       String
  product         StoreProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  colorHex        String
  colorName       String
  badge           String?          @default("")
  sku             String?
  priceAdjustment Float            @default(0.0)
  stock           Int              @default(100)
  isActive        Boolean          @default(true)

  inventory       StoreInventory[]
  cartItems       StoreCartItem[]
  orderItems      StoreOrderItem[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([productId])
  @@index([sku])
}

model StoreProductOption {
  id          String           @id @default(uuid())
  productId   String
  product     StoreProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String           // "storage" | "lens"
  name        String
  size        String?
  description String?
  priceAdd    Float            @default(0.0)
  sku         String?
  stock       Int              @default(100)
  isActive    Boolean          @default(true)

  inventory   StoreInventory[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([productId])
  @@index([type])
}

model StoreInventory {
  id           String               @id @default(uuid())
  productId    String
  product      StoreProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      StoreProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  optionId     String?
  option       StoreProductOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)
  sku          String               @unique
  quantity     Int                  @default(100)
  reserved     Int                  @default(0)
  minThreshold Int                  @default(5)

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([productId])
  @@index([variantId])
  @@index([sku])
}

model StoreCart {
  id        String          @id @default(uuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     StoreCartItem[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
}

model StoreCartItem {
  id               String               @id @default(uuid())
  cartId           String
  cart             StoreCart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId        String
  product          StoreProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          StoreProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  storageOptionId  String?
  lensOptionId     String?
  quantity         Int                  @default(1)
  unitPrice        Float

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([cartId])
  @@index([productId])
}

model StoreCoupon {
  id             String          @id @default(uuid())
  code           String          @unique
  type           StoreCouponType @default(PERCENTAGE)
  discountValue  Float
  minOrderAmount Float           @default(0.0)
  maxDiscount    Float?
  maxUses        Int?
  usedCount      Int             @default(0)
  perUserLimit   Int             @default(1)
  expiresAt      DateTime?
  isActive       Boolean         @default(true)

  orders         StoreOrder[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([code])
  @@index([isActive])
}

model StoreOrder {
  id                  String                    @id @default(uuid())
  orderNumber         String                    @unique
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  status              StoreOrderStatus          @default(PENDING_PAYMENT)
  paymentStatus       StorePaymentStatus        @default(PENDING)
  paymentIntentId     String?                   @unique
  stripeSessionId     String?
  subtotal            Float
  discount            Float                     @default(0.0)
  shippingCost        Float                     @default(0.0)
  total               Float
  currency            String                    @default("usd")
  
  couponId            String?
  coupon              StoreCoupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)

  shippingAddress     Json                      // Snapshot of recipient & address
  billingAddress      Json?                     // Snapshot of billing info
  customerEmail       String
  customerName        String
  customerPhone       String?

  items               StoreOrderItem[]
  statusHistory       StoreOrderStatusHistory[]
  shipments           StoreShipment[]

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model StoreOrderItem {
  id             String               @id @default(uuid())
  orderId        String
  order          StoreOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        StoreProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        StoreProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName    String
  variantName    String?
  storageName    String?
  lensName       String?
  sku            String?
  quantity       Int
  unitPrice      Float
  total          Float
  image          String?
  specsSnapshot  Json?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([orderId])
  @@index([productId])
}

model StoreOrderStatusHistory {
  id        String           @id @default(uuid())
  orderId   String
  order     StoreOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    StoreOrderStatus
  notes     String?
  changedBy String?          @default("SYSTEM")

  createdAt DateTime         @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model StoreShipment {
  id                String              @id @default(uuid())
  orderId           String
  order             StoreOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber    String              @unique
  carrier           String              @default("DHL Express")
  status            StoreShipmentStatus @default(PREPARING)
  labelUrl          String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  timeline          Json?               @default("[]")

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
}

model StoreReview {
  id               String       @id @default(uuid())
  productId        String
  product          StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int          @default(5)
  title            String?
  comment          String
  verifiedPurchase Boolean      @default(false)
  isApproved       Boolean      @default(true)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([isApproved])
}

