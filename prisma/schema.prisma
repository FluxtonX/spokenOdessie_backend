datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  password              String?           // Hashed (null for Google-only accounts)
  googleId              String?           @unique
  displayName           String?
  photoURL              String?           // Public URL
  photoKey              String?           // S3 Key for profile picture
  coverURL              String?           // Public URL
  coverKey              String?           // S3 Key for cover photo
  bio                   String            @default("")
  profession            String            @default("")
  location              String            @default("Earth")
  birthDate             String            @default("")
  lifeMotto             String            @default("")
  expertise             String[]          @default([])
  defaultEntryPrivacy   String            @default("Private - Only by you")
  profileVisibility     String            @default("Follower only")
  onboardingCompleted   Boolean           @default(false)
  profileCompleted      Boolean           @default(false)
  role                  Role              @default(USER)
  isActive              Boolean           @default(true)
  lastLogin             DateTime          @default(now())
  lastActive            DateTime          @default(now())
  
  // Forgot Password fields
  passwordResetToken   String?           @unique
  passwordResetExpires DateTime?
  
  // Phone number for SMS invitations
  phoneNumber           String?           @unique
  countryCode           String?           @default("+1")
  phoneVerified         Boolean           @default(false)
  
  // Custom metadata (personality Q&As, goals, projects, values, etc.)
  goals                 String            @default("")
  projects              String            @default("")
  achievements          String            @default("")
  interests             String            @default("")
  lessons               String            @default("")
  values                String            @default("")
  causes                String            @default("")
  personalityQs         Json              @default("[{\"q\":\"What is your happiest memory from childhood?\",\"a\":\"\"},{\"q\":\"How would you like to be remembered?\",\"a\":\"\"}]")
  recentInteractions    Json              @default("[]")

  // Relations
  memories              Memory[]
  albums                Album[]
  comments              Comment[]
  postReactions         PostReaction[]
  commentReactions      CommentReaction[]
  
  // Self-referencing Follows
  followers             Follow[]          @relation("following")
  following             Follow[]          @relation("follower")

  // Bidirectional Family Connections (represented via a junction table)
  familyConnectsAsFirst FamilyConnection[] @relation("user1")
  familyConnectsAsSec   FamilyConnection[] @relation("user2")

  // Family Invitations
  sentInvitations       FamilyInvitation[] @relation("InvitationSender")
  receivedInvitations   FamilyInvitation[] @relation("InvitationReceiver")

  // Family Circle Memberships
  familyMemberships     FamilyMember[]

  // Notifications
  notifications         Notification[]
  deviceTokens          DeviceToken[]

  // Legacy Access Settings
  legacySettings        LegacySettings?

  // MFA & Security Configuration
  mfaEnabled            Boolean           @default(false)
  mfaTypes              String[]          @default([])
  totpSecret            MfaTotpSecret?
  passkeys              Passkey[]
  recoveryCodes         MfaRecoveryCode[]
  auditLogs             SecurityAuditLog[]
  sessions              UserSession[]
  passwordChangedAt     DateTime?
  loginNotifications    Boolean           @default(true)
  notificationPreferences Json?           @default("{\"followerActivity\":true,\"familyActivity\":true,\"memoryInteractions\":true,\"securityAlerts\":true,\"loginNotifications\":true}")

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([email])
  @@index([phoneNumber])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique // Session JTI or token hash
  deviceName   String   @default("Web Device")
  deviceType   String   @default("desktop")
  ipAddress    String?
  userAgent    String?
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum FamilyRole {
  ADMIN
  MEMBER
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FamilyConnection {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String

  user1     User     @relation("user1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("user2", fields: [user2Id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model FamilyCircle {
  id          String   @id @default(uuid())
  name        String   @default("My Family")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     FamilyMember[]
  invitations FamilyInvitation[]
}

model FamilyMember {
  id              String       @id @default(uuid())
  familyCircleId  String
  userId          String
  role            FamilyRole   @default(MEMBER)
  relationship    String       @default("Family Member")
  invitedBy       String?
  approvedBy      String?

  familyCircle    FamilyCircle @relation(fields: [familyCircleId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt        DateTime     @default(now())
  approvedAt      DateTime?

  @@unique([familyCircleId, userId])
  @@index([familyCircleId])
  @@index([userId])
  @@index([role])
}

model FamilyInvitation {
  id              String   @id @default(uuid())
  familyCircleId  String
  senderId        String
  receiverId      String?
  email           String?
  phoneNumber     String?
  countryCode     String?   @default("+1")
  invitationToken String   @unique
  relationship    String   @default("Family Member")
  status          String   @default("PENDING") // PENDING, ACCEPTED, APPROVED, DECLINED, EXPIRED
  method          String   @default("EMAIL") // EMAIL, SMS, LINK, QR

  sender          User     @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User?    @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  familyCircle    FamilyCircle @relation(fields: [familyCircleId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime?
  acceptedAt      DateTime?
  approvedAt      DateTime?

  @@index([senderId])
  @@index([receiverId])
  @@index([email])
  @@index([phoneNumber])
  @@index([status])
  @@index([invitationToken])
  @@index([familyCircleId])
}

model Album {
  id               String   @id @default(uuid())
  title            String
  subtitle         String   @default("")
  coverImageKey    String?
  privacy          String   @default("Private")
  entries          Int      @default(0)
  
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  memories         Memory[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
  @@index([privacy])
}

model Memory {
  id                String         @id @default(uuid())
  title             String
  description       String         @default("")
  tags              String[]       @default([])
  taggedUserIds     String[]       @default([])
  mood              String         @default("")
  privacy           String         @default("Private")
  type              String         @default("Text")
  status            String         @default("draft")
  occurredAt        DateTime       @default(now())
  color             String         @default("")
  backgroundId      String         @default("none")
  fontId            String         @default("default")

  // Legacy single file keys (for backwards compatibility)
  mediaKey          String?
  thumbnailKey      String?
  mediaOriginalName String         @default("")
  mediaMimeType     String         @default("")

  // Multi-media list support (stored as structured JSON)
  mediaList         Json           @default("[]")

  // Counters
  likes             Int            @default(0)
  commentsCount     Int            @default(0)
  shares            Int            @default(0)

  ownerId           String
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  albumId           String?
  album             Album?         @relation(fields: [albumId], references: [id], onDelete: SetNull)

  comments          Comment[]
  reactions         PostReaction[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([ownerId])
  @@index([albumId])
  @@index([status])
  @@index([privacy])
}

model PostReaction {
  id        String   @id @default(uuid())
  memoryId  String
  userId    String
  type      String   // "heart", "like", "wow", "haha", "angry"

  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([memoryId, userId])
  @@index([memoryId])
  @@index([userId])
}

model Comment {
  id              String            @id @default(uuid())
  text            String
  reactionsCount  Json              @default("{\"like\":0,\"love\":0,\"haha\":0,\"wow\":0,\"sad\":0}")
  
  memoryId        String
  memory          Memory            @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  
  ownerId         String
  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  parentCommentId String?
  parentComment   Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]         @relation("CommentReplies")

  reactions       CommentReaction[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([memoryId])
  @@index([ownerId])
  @@index([parentCommentId])
}

model CommentReaction {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  type      String   // "like", "love", "haha", "wow", "sad"

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "FAMILY_INVITE_ACCEPTED", "FAMILY_INVITE_APPROVED", "FAMILY_INVITE_DECLINED", "MEMORY_LIKE", "MEMORY_COMMENT", etc.
  title       String
  message     String
  metadata    Json?    // Additional data (e.g., invitationId, familyCircleId, etc.)
  isRead      Boolean  @default(false)
  actionUrl   String?  // URL to navigate to when clicked

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  deviceType String   @default("web")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model LegacySettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  administratorId     String?
  administratorName   String   @default("Sarah Murphy")

  releaseCondition    String   @default("After verified passing")
  familyCircleAccess  String   @default("Full archive")
  publicProfile       String   @default("Remain public")

  isReleased          Boolean  @default(false)
  releasedAt          DateTime?
  releasedBy          String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

model MfaTotpSecret {
  id          String   @id @default(uuid())
  userId      String   @unique
  secret      String
  verified    Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Passkey {
  id           String   @id @default(uuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[] @default([])
  deviceName   String   @default("Passkey")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
  @@index([credentialId])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([codeHash])
}

model SecurityAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
